{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@pages": ["./src/pages"],
      "@pages/*": ["./src/pages/*"],
      "@items": ["./src/components/items"],
      "@items/*": ["./src/components/items/*"],
      "@ui": ["./src/components/ui"],
      "@ui/*": ["./src/components/ui/*"],
      "@modals": ["./src/components/modals"],
      "@modals/*": ["./src/components/modals/*"],
      "@assets/*": ["./src/assets/*"],
      "@store": ["./src/services/store"],
      "@slices/*": ["./src/services/slices/*"],
      "@utils/*": ["./src/utils/*"],
      "@utils-api/*": ["./src/utils/api/*"],
      "@types": ["./src/types"],
      "@types/*": ["./src/types/*"],
      "@styles/*": ["./src/styles/*"],
      "@hooks/*": ["./src/hooks/*"]
    }
  },
  "include": ["src"]
}
